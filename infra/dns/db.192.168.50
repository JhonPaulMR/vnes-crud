; /etc/bind/zones/db.192.168.50  -  zona reversa 192.168.50.0/24
$TTL    300
@       IN      SOA     ns1.vnes.com.br. admin.vnes.com.br. (
                        2026102801      ; serial (YYYYMMDDNN)
                        3600            ; refresh
                        900             ; retry
                        604800          ; expire
                        300 )           ; negative cache TTL

@       IN      NS      ns1.vnes.com.br.

10      IN      PTR     ns1.vnes.com.br.
20      IN      PTR     cloud.vnes.com.br.
